# kariyer-mail-service — copy to .env (docker-compose loads it with env_file).
# Anything not set here falls back to src/Kariyer.Mail.Api/appsettings.json; override any
# section the .NET way, e.g. ConnectionStrings__Postgres=..., Email__...=...

# ── Build ────────────────────────────────────────────────────────────────────
# GitHub Packages credentials for Kariyer.Messaging.Contracts (read:packages is enough).
GITHUB_USER=
GITHUB_TOKEN=

# ── System template slots ────────────────────────────────────────────────────
# One slug per slot. A slot whose slug is unset shows as empty in the admin panel and cannot
# have a template bound to it; an event that needs it fails loudly.
#
# Keep whatever slug an environment already uses: the slug IS the binding, so changing it
# detaches the template the admin panel assigned.

# Account
EmailTemplates__AccountCreatedTemplateSlug=account-created
EmailTemplates__AccountCompletedTemplateSlug=account-completed
EmailTemplates__AccountApprovedTemplateSlug=account-approved
EmailTemplates__AccountRejectedTemplateSlug=account-rejected
EmailTemplates__AccountFrozenTemplateSlug=account-frozen
EmailTemplates__AccountDeletedTemplateSlug=account-deleted
EmailTemplates__AccountDeletionCancelledTemplateSlug=account-deletion-cancelled
EmailTemplates__AccountDidNotCompletedStep1TemplateSlug=account-did-not-complete-1
EmailTemplates__AccountDidNotCompletedStep2TemplateSlug=account-did-not-complete-2
EmailTemplates__AccountDidNotCompletedStep3TemplateSlug=account-did-not-complete-3
EmailTemplates__AccountEmailChangedTemplateSlug=account-email-changed
EmailTemplates__AccountPhoneChangedTemplateSlug=account-phone-changed
EmailTemplates__AccountUsernameChangedTemplateSlug=account-username-changed
EmailTemplates__AdminCompanyCompletedTemplateSlug=admin-company-completed

# İş uyarıları (one per send window)
EmailTemplates__JobAlertMorningTemplateSlug=job-alert-morning
EmailTemplates__JobAlertNoonTemplateSlug=job-alert-noon
EmailTemplates__JobAlertEveningTemplateSlug=job-alert-evening

# Mülakat — to the candidate
EmailTemplates__InterviewInvitedTemplateSlug=interview-invited
EmailTemplates__InterviewRescheduledTemplateSlug=interview-rescheduled
EmailTemplates__InterviewCancelledTemplateSlug=interview-cancelled

# Mülakat — the candidate's answer, to the company side
EmailTemplates__InterviewAcceptedTemplateSlug=interview-accepted
EmailTemplates__InterviewDeclinedTemplateSlug=interview-declined

# Başvuru
EmailTemplates__ApplicationSubmittedTemplateSlug=application-submitted
EmailTemplates__ApplicationSubmittedCompanyTemplateSlug=application-submitted-company
EmailTemplates__ApplicationWithdrawnTemplateSlug=application-withdrawn

# Başvuru kararları — to the candidate, after the hold below
EmailTemplates__ApplicationOfferTemplateSlug=application-offer
EmailTemplates__ApplicationHiredTemplateSlug=application-hired
EmailTemplates__ApplicationRejectedTemplateSlug=application-rejected

# Hizmet sayfası formu
EmailTemplates__ServiceLeadTemplateSlug=service-lead

# ── Başvuru karar mailleri (optional; defaults shown) ────────────────────────
# How long an offer / hire / rejection mail waits so a corrected misclick never reaches the
# candidate, how often held mails are checked, and how many are sent per pass.
# RecruitingMail__StageMailHoldMinutes=10
# RecruitingMail__DispatchCronExpression=* * * * *
# RecruitingMail__DispatchBatchSize=100
