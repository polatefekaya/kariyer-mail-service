{
  "Logging": {
    "LogLevel": {
      "Default": "Trace"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "OtlpEndpoint": "http://localhost:4317",
    "ServiceVersion": "1.0.0",
    "DeploymentEnvironment": "development"
  },
  "Retention": {
    "TargetRetentionDays": 30,
    "DeletionBatchSize": 5000,
    "CronExpression": "0 3 * * *"
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Database=dev_db",
    "RabbitMQ": "amqp://guest:guest@localhost:5672/",
    "Garnet": "localhost:6379"
  },
  "LegacySystem": {
    "BaseUrl": "http://localhost:5000",
    "Token": "local-dev-token"
  },
  "Email": {
    "ActiveProvider": "SMTP",
    "Token": "bb",
    "BaseUrl": "a"
  }
}
